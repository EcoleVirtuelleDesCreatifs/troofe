APP_NAME="Trôofê"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://troofe.net
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=troofe
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Courriels (LWS : mail.votredomaine.com, port 465, ssl)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.troofe.net
MAIL_PORT=465
MAIL_USERNAME=notifications@troofe.net
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notifications@troofe.net
MAIL_FROM_NAME="Trôofê"

# Adresse qui reçoit les alertes de l'équipe (nouvelles fiches, contact, campagnes)
TROOFE_ADMIN_EMAIL=contact@troofe.net
TROOFE_CURRENCY=XOF
TROOFE_COMMISSION_RATE=8

# Paiements : "simulation" (tests, aucun débit) ou "cinetpay"
PAYMENT_DRIVER=simulation
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# SEO / GEO
TROOFE_SOCIAL_PROFILES="https://www.facebook.com/troofe,https://www.instagram.com/troofe"
TROOFE_TWITTER=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Clé IndexNow (32 caractères hexadécimaux) : Bing, Yandex, Seznam… sont prévenus à chaque publication
INDEXNOW_KEY=
